# Harmony Lifestyle Academy - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Config (get from https://supabase.com/dashboard → Settings → API)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: NEVER put secrets in VITE_* variables — Vite bundles them into public JS.
# Server-side secrets (NOT in this file, NOT in frontend env):
#   Gemini key     → Supabase Dashboard → Edge Functions → Secrets (ai-proxy)
#   ANTHROPIC_API_KEY, TOYYIBPAY_*, SUPABASE_SERVICE_ROLE_KEY
#                  → Vercel → Project Settings → Environment Variables
#                    (see DEPLOYMENT_GUIDE.md LANGKAH 6.2)