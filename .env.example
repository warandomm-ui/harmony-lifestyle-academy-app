# Harmony Lifestyle Academy - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Config (get from https://supabase.com/dashboard → Settings → API)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: AI API keys (Gemini, Anthropic) are stored securely
# in Supabase Edge Function secrets - NOT in frontend env
# Set them in: Supabase Dashboard → Edge Functions → Secrets

# ─── HLA Connector Secrets (store in Supabase Edge Function secrets) ───
# Google OAuth (Calendar, Gmail, Drive)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Asana
# ASANA_ACCESS_TOKEN=your_asana_personal_access_token