@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: #ffffff;
  --foreground: #1a1a2e;
  --card: #ffffff;
  --border: #e5e7eb;
  --primary: #6d28d9;
  --primary-foreground: #ffffff;
  --secondary: #f3f4f6;
  --muted: #6b7280;
  --accent: #f59e0b;
}

.dark {
  --background: #0f0f23;
  --foreground: #e2e8f0;
  --card: #1a1a2e;
  --border: #2d2d44;
  --primary: #8b5cf6;
  --primary-foreground: #ffffff;
  --secondary: #1e1e32;
  --muted: #94a3b8;
  --accent: #f59e0b;
}

body {
  font-family: 'Poppins', sans-serif;
  background-color: var(--background);
  color: var(--foreground);
  transition: background-color 0.3s, color 0.3s;
}

.bento-card {
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 1.5rem;
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fade-in 0.5s ease-out;
}
